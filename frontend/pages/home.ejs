<%- include('../partials/header') %>

<style>
    body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    .main-card { border: none; border-radius: 15px; background: white; }
    .welcome-text { color: #2c3e50; font-weight: 700; }
    .btn-custom { border-radius: 10px; padding: 12px 20px; transition: all 0.3s; }
    .btn-custom:hover { transform: scale(1.02); }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="main-card shadow-lg p-5">
                <div class="text-center mb-4">
                    <h2 class="welcome-text">Olá, <%= userLogged.name %>!</h2>
                    <p class="text-muted">Bem-vindo ao sistema de gestão da sua congregação.</p>
                </div>

                <hr>

                <div class="row mt-4">
                    <div class="col-sm-12">
                        <div class="p-3 border rounded bg-light mb-3">
                            <h5><i class="bi bi-wallet2 me-2"></i>Financeiro</h5>
                            <p class="small text-muted">Consulte aqui seu histórico completo de contribuições.</p>
                            <a href="/user/seefees" class="btn btn-primary btn-custom w-100">
                                Ver Meus Dízimos e Ofertas
                            </a>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a href="/login/logout" class="text-danger fw-bold text-decoration-none">
                        <i class="bi bi-box-arrow-right me-1"></i> Sair do Sistema
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>