<%- include('../partials/header') %>

<style>
    body { background-color: #f0f2f5; }
    .dash-container { padding-top: 30px; }
    .stat-card {
        border: none;
        border-radius: 15px;
        transition: transform 0.2s;
        color: white;
    }
    .stat-card:hover { transform: scale(1.03); }
    .icon-bg { font-size: 2.5rem; opacity: 0.3; position: absolute; right: 15px; bottom: 10px; }
    .card-title { font-size: 1.1rem; font-weight: 300; }
    .card-value { font-size: 2.2rem; font-weight: 700; }
</style>

<div class="container dash-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Painel de Controle <span class="badge bg-dark text-uppercase" style="font-size: 0.5em;">Admin</span></h2>
        <a href="/user/home" class="btn btn-outline-secondary btn-sm">Voltar ao Portal</a>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card stat-card bg-primary shadow">
                <div class="card-body">
                    <div class="card-title text-uppercase">Membros Ativos</div>
                    <div class="card-value"><%= totalUsers %></div>
                    <i class="bi bi-people-fill icon-bg"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card stat-card bg-info shadow">
                <div class="card-body text-white">
                    <div class="card-title text-uppercase">Igrejas Parceiras</div>
                    <div class="card-value"><%= totalChurches %></div>
                    <i class="bi bi-church icon-bg"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card stat-card bg-success shadow">
                <div class="card-body">
                    <div class="card-title text-uppercase">Contribuições (Mês Atual)</div>
                    <div class="card-value"><%= payedFees %></div>
                    <i class="bi bi-check-circle-fill icon-bg"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mt-2">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold">Gestão Operacional</h5>
        </div>
        <div class="card-body">
            <div class="list-group list-group-flush">
                
                <a href="/admin/members" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                    Gerenciar Membros da Igreja
                    <span class="badge bg-primary rounded-pill">></span>
                </a>

                <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3" data-bs-toggle="modal" data-bs-target="#modalFiltro">
                    Filtrar Membros por Status
                    <span class="badge bg-success rounded-pill">Filtrar</span>
                </button>

                <a href="/admin/church/create" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                    Configurações das Igrejas
                    <span class="badge bg-primary rounded-pill">></span>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalFiltro" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Relatório Personalizado</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/admin/seemembers" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">ID da Igreja</label>
            <input type="number" name="churchId" class="form-control" required placeholder="Digite o ID da congregação">
          </div>
          <div class="mb-3">
            <label class="form-label">Status do Pagamento</label>
            <select name="feeStatus" class="form-select">
              <option value="true">Pagos</option>
              <option value="false">Pendentes</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Gerar Lista</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>