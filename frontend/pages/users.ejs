<%- include('../partials/header') %>

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Membros da Congregação</h3>
            <a href="/admin/dashboard" class="btn btn-light btn-sm">Voltar</a>
        </div>
        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>E-mail</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(user => { %>
                        <tr>
                            <td><%= user.name %></td>
                            <td><%= user.email %></td>
                            <td class="text-end">
                                <a href="/admin/user/fees/<%= user.id %>" class="btn btn-info btn-sm">
                                    <i class="bi bi-cash-stack"></i> Ver Taxas
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>